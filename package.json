{
  "name": "elm-pages-app",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "postinstall": "cd frontend && elm-tooling install",
    "start": "cd frontend && elm-pages dev",
    "build": "cd frontend && elm-pages build",
    "test:ts": "vitest",
    "test:e2e": "npx playwright test",
    "test:elm": "cd frontend && elm-pages gen && npx elm-test --fuzz 10000",
    "fetch": "npx tsx scripts/fetch_books.ts",
    "import": "npx tsx scripts/import.ts",
    "db:codegen": "npx kysely-codegen --dialect sqlite --url books.db --out-file frontend/custom-tasks/db-types.ts",
    "db:verify": "npm run db:codegen -- --verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "better-sqlite3": "^12.11.1",
    "elm": "^0.19.1-6",
    "elm-codegen": "^0.6.3",
    "elm-optimize-level-2": "^0.4.0",
    "elm-pages": "3.5.1",
    "elm-review": "^2.13.5",
    "elm-test": "0.19.1-revision17",
    "elm-tooling": "^1.18.0",
    "kysely": "^0.29.3",
    "kysely-codegen": "^0.20.0",
    "lamdera": "^0.19.1-1.4.0",
    "node-fetch": "^3.3.2",
    "p-queue": "^9.3.1",
    "slugify": "^1.6.9",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
